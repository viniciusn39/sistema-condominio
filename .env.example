# Copie para .env e ajuste antes do primeiro "docker compose up".

# Domínio público apontando (registro DNS tipo A) para o IP do servidor.
# O Caddy emite o certificado HTTPS automaticamente para ele.
DOMINIO=votacao.seucondominio.com.br

# Nome do condomínio exibido no site e no sistema (opcional; ex.: Edifício Jardim das Flores).
CONDOMINIO_NOME=

# Login inicial do síndico, usado só na criação do banco.
EMAIL_SINDICO=sindico@seucondominio.com.br
# Troque depois em "Trocar senha" dentro do sistema.
SENHA_SINDICO=troque-esta-senha

# Cookies só por HTTPS (mantenha 1 em produção).
COOKIE_SECURE=1

# 1 = cria o banco com moradores e votações de exemplo (só para testar).
DEMO=0
